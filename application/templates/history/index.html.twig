{% extends 'base.html.twig' %}

{% block title %}Historique{% endblock %}

{% block body %}
    <div class="container-height text-center">
        <h1>Historique des fichiers générés</h1>
        <p> Nombre de pdf généré : {{ nbpdf}} </p>
        <div>
        <p>
            Vous pouvez en générer encore :
            {{ (maxPdf - nbpdf) < 0 ? 0 : (maxPdf - nbpdf) }}
        </p>

        {% if (maxPdf - nbpdf) <= 0 %}
            <a class="btn btn-primary" href="{{ path('app_subscription') }}">Abonnez-vous pour plus de génération</a>
        {% endif %}
        </div>
        {% if files is not empty %}
            <ul class="history">
                {% for file in files %}
                    <li>
                        <strong>{{ file.name }}</strong> - {{ file.createdAt|date('d/m/Y H:i') }}
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p>Aucun fichier n'a été généré jusqu'à présent.</p>
        {% endif %}
    </div>
{% endblock %}
